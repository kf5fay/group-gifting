# Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Database Connection (provided automatically by Railway)
DATABASE_URL=postgresql://user:password@host:5432/database

# Admin dashboard password (required for /admin)
# Pick a long random value. On Railway, set this in the project's
# environment variables rather than in a file.
ADMIN_PASSWORD=change_me_to_a_long_random_value

# Server Port (Railway sets this automatically)
PORT=3000

# Instructions:
# 1. Create a file named .env in the root directory
# 2. Copy the variables above
# 3. Fill in your actual values
# 4. Never commit .env to git (it's in .gitignore)
